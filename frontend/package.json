{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "NUXT_DEVTOOLS_ENABLED=false NUXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' nuxt dev --no-clear --host 0.0.0.0",
    "dev:turbo": "NUXT_DEVTOOLS_ENABLED=false NUXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=8192 --no-warnings' nuxt dev --no-clear --host 0.0.0.0 --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.4",
    "@nuxt/image": "^1.8.1",
    "@vueuse/components": "^11.2.0",
    "@vueuse/core": "^11.2.0",
    "animejs": "^3.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "nuxt": "^3.14.159"
  },
  "overrides": {
    "nuxt": {
      "@parcel/watcher": "2.5.0"
    }
  }
}